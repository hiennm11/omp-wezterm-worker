{
	"name": "omp-wezterm-worker",
	"version": "0.1.0",
	"description": "Spawn an independent OMP worker session inside a WezTerm pane or tab. The user watches it live while the main agent keeps working; the worker's final result is delivered back into the main session.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"omp-package",
		"wezterm",
		"pane",
		"worker",
		"async"
	],
	"scripts": {
		"test": "node --test tests/*.test.ts",
		"test:unit": "node --test tests/transcript.test.ts tests/config.test.ts tests/registry.test.ts tests/ste100.test.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"ste100": "node tools/ste100-cli.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"check": "npm run lint && npm run typecheck && npm run ste100 && npm run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^22.20.5"
	},
	"omp": {
		"extensions": [
			"./extensions/wezterm-worker.ts"
		]
	},
	"pi": {
		"extensions": [
			"./extensions/wezterm-worker.ts"
		]
	}
}
